{
  "manifest_version": 3,
  "name": "KRain Stake Report",
  "version": "1.3.0",
  "description": "Adds up stake x odds / 100 on the Rain / No Rain lists of krain88 for each time slot (18-06, 06-12, 06-18) and keeps a day-by-day report.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "KRain Stake Report",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://krain88.com/*", "*://*.krain88.com/*"],
      "js": ["parser.js", "content.js"],
      "css": ["panel.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
